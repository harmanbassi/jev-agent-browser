@@ -0,0 +1,54 @@
+"""Exact-name tool visibility pins must preserve scope and bridge consistency."""
+import json
+import pytest
+from tools import tool_search as ts
+
+
+def td(name):
+    return {"type": "function", "function": {"name": name, "description": name,
+            "parameters": {"type": "object", "properties": {}}}}
+
+
+@pytest.fixture
+def configured(monkeypatch):
+    cfg = ts.ToolSearchConfig.from_raw({"keep": ["browser_task", "not_enabled"],
+                                       "defer": ["browser_task"]})
+    monkeypatch.setattr(ts, "load_config_readonly", lambda: cfg)
+    monkeypatch.setattr(ts, "_registry_toolset", lambda name: "browser_task" if name == "browser_task" else "other-plugin")
+    monkeypatch.setattr(ts, "connections_in_scope", lambda defs: False)
+    return cfg
+
+
+def test_keep_is_empty_by_default_and_invalid_values_are_not_tool_names(caplog):
+    assert not ts.ToolSearchConfig.from_raw(None).keep_tools
+    assert ts.ToolSearchConfig.from_raw({"keep": [" browser_task ", None, 12, ""]}).keep_tools == {"browser_task"}
+    assert not ts.ToolSearchConfig.from_raw({"keep": "browser_task"}).keep_tools
+    assert "must be a list" in caplog.text
+
+
+def test_keep_retains_only_enabled_named_tools_and_other_plugins_still_defer(configured):
+    defs = [td("browser_task"), td("other_tool")]
+    result = ts.assemble_tool_defs(defs, config=configured)
+    names = {t["function"]["name"] for t in result.tool_defs}
+    assert "browser_task" in names and "other_tool" not in names
+    assert "not_enabled" not in names and "tool_search" in names
+    assert ts.scoped_deferrable_names(defs) == {"other_tool"}
+    assert ts.scoped_deferrable_names([td("other_tool")]) == {"other_tool"}
+    assert [t["function"]["name"] for t in ts._deferrable_in(defs)] == ["other_tool"]
+
+
+def test_bridge_rejects_direct_tool_and_describe_does_not_advertise_it(configured, monkeypatch):
+    monkeypatch.setattr(ts, "_registry_entry", lambda name: object())
+    monkeypatch.setattr("tools.tool_search_validation._registry_entry", lambda name: object())
+    defs = [td("browser_task"), td("other_tool")]
+    described = json.loads(ts.dispatch_tool_describe({"names": ["browser_task"]}, current_tool_defs=defs))
+    assert "directly-listed" in described["errors"]["browser_task"]
+    name, args, error = ts.resolve_underlying_call({"calls": [{"name": "browser_task", "arguments": {}}]})
+    assert name is None and "directly-listed" in error
+
+
+def test_visibility_does_not_leak_between_profile_configurations(configured):
+    defs = [td("browser_task"), td("other_tool")]
+    plain = ts.ToolSearchConfig.from_raw({})
+    assert "browser_task" in {t["function"]["name"] for t in ts.assemble_tool_defs(defs, config=configured).tool_defs}
+    assert "browser_task" not in {t["function"]["name"] for t in ts.assemble_tool_defs(defs, config=plain).tool_defs}
