# Client settings. Export these before running Python/CLI/MCP, or let your agent
# inject them. jev-browser deliberately does not auto-load files from the cwd.
JEV_OPENROUTER_KEY=replace-with-your-openrouter-key
# Optional: used only when JEV_OPENROUTER_KEY is unset.
# OPENROUTER_API_KEY=
# Optional model and endpoint overrides (defaults shown).
# JEV_MODEL=~typesafe/jev-latest
# JEV_TEXT_MODEL=inception/mercury-2.5
# JEV_URL=https://openrouter.ai/api/alpha/decisions
# JEV_TEXT_URL=https://openrouter.ai/api/v1/chat/completions
# Optional lean click route from camofox_plugin/; 1 enables it.
# JEV_FAST_CLICK=0
CAMOFOX_URL=http://127.0.0.1:9377
# Optional published host port for Compose. If changed, update CAMOFOX_URL too.
CAMOFOX_PORT=9377
# New Camofox: this gates browser-control routes. Legacy CAMOFOX_API_KEY remains
# supported by the client; for Hermes set CAMOFOX_API_KEY to this same access key.
CAMOFOX_ACCESS_KEY=replace-with-a-long-random-browser-key
CAMOFOX_API_KEY=replace-with-the-same-browser-key-for-hermes
# Node old-generation heap budget in MiB, separate from Firefox/container memory.
CAMOFOX_HEAP_MB=512
JEV_ALLOW_PRIVATE_URLS=0
# Optional exact hostname allowlist, comma separated. No wildcards.
JEV_ALLOWED_HOSTS=
# Browser-side proxy only. Empty = direct connections; no proxy subscription needed.
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Explicit permission to send masked viewport images to OpenRouter/Jev.
JEV_VISION_ENABLED=0
# off | auto | always. Task options cannot override disabled permission.
JEV_VISION_MODE=auto
JEV_VISION_MODEL=typesafe/jev-1.14
# Image HTTP attempts, including retries and completion verification, per task.
JEV_VISION_MAX_CALLS=4
# Experimental box cross-check. Still executes only observed DOM targets.
JEV_VISION_BOX=0
